# Flowstate — see README.md

# Postgres. Use a pooled URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowstate?schema=public"

# Session signing secret (min 32 chars): openssl rand -base64 32
AUTH_SECRET=

# Public base URL for links (praise links, shift requests). Falls back to the request host.
APP_URL=

# Shows demo sign-in details on the sign-in page. Leave unset on customer deployments.
NEXT_PUBLIC_DEMO_MODE=

# Assist (Persona). Without it, Assist says it isn't set up.
ANTHROPIC_API_KEY=

# Sign in with Aultrum ID needs no settings when deployed (Flowstate signs its
# requests with its own key, published at /.well-known/jwks.json). Flowstate
# must be registered as a product in Aultrum ID first. For local development:
# AULTRUM_ID_URL=http://id.localhost:3300
